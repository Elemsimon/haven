# ─────────────────────────────────────────────
#  ryan Heights Hotel — Environment Variables
#  Copy this file to .env.local and fill in your values
# ─────────────────────────────────────────────

# ── Next Auth ─────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# ── OAuth Providers ───────────────────────────
# GitHub: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Google: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Sanity CMS ────────────────────────────────
# Create project at https://sanity.io/
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
# Token with write access (for mutations)
SANITY_STUDIO_TOKEN=your_sanity_token

# ── Stripe ────────────────────────────────────
# https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key
# From Stripe CLI: stripe listen --forward-to localhost:3000/api/webhook
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ── App ───────────────────────────────────────
APP_URL=http://localhost:3000
